<body>

  <main class="container">

    <section class="hero">

      <h1>업무 FAQ 검색</h1>

      <p>
        질문이나 키워드를 입력해 필요한 업무 FAQ를 빠르게 찾아보세요.
      </p>

      <div class="search-panel">

        <div class="search-row">

          <input
            id="searchInput"
            class="search-input"
            type="search"
            placeholder="질문이나 키워드를 입력하세요."
          />

          <button
            id="resetButton"
            class="reset-button"
            type="button"
          >
            전체보기
          </button>

        </div>

        <div class="filter-wrap">

          <span class="filter-title">
            분류
          </span>

          <div class="category-buttons">

            <button
              class="category-button active"
              data-category="전체">
              전체
            </button>

            <button
              class="category-button"
              data-category="교육">
              교육
            </button>

            <button
              class="category-button"
              data-category="문서">
              문서
            </button>

            <button
              class="category-button"
              data-category="IT">
              IT
            </button>

            <button
              class="category-button"
              data-category="보안">
              보안
            </button>

          </div>

        </div>

      </div>

    </section>

    <div class="results-header">

      <h2>검색 결과</h2>

      <p id="resultCount"></p>

    </div>

    <section
      id="faqList"
      class="faq-list">
    </section>

  </main>

  <script>

    const faqData = [

      {
        category: "교육",
        question: "교육 신청은 어디에서 하나요?",
        answer_seed:
          "교육 포털의 과정 검색 후 신청 메뉴를 사용합니다."
      },

      {
        category: "교육",
        question:
          "신청한 교육을 취소하려면 어떻게 하나요?",
        answer_seed:
          "신청내역에서 취소 가능 여부를 확인합니다."
      },

      {
        category: "문서",
        question:
          "주간 업무보고에는 무엇을 넣어야 하나요?",
        answer_seed:
          "주요 실적, 이슈, 다음 주 계획을 중심으로 작성합니다."
      },

      {
        category: "IT",
        question:
          "사내 시스템 접속이 되지 않습니다.",
        answer_seed:
          "네트워크, 브라우저, 계정 상태를 순서대로 확인합니다."
      },

      {
        category: "보안",
        question:
          "ChatGPT에 내부 업무자료를 넣어도 되나요?",
        answer_seed:
          "교육에서는 합성자료를 사용하고, 실제 자료는 조직의 보안 및 AI 사용 기준을 먼저 확인합니다."
      },

      {
        category: "교육",
        question:
          "신청한 교육을 다른 차수로 변경하려면 어떻게 하나요?",
        answer_seed:
          "기신청한 교육을 취소 후 다시 신청하시면 됩니다."
      }

    ];


    const searchInput =
      document.getElementById("searchInput");

    const resetButton =
      document.getElementById("resetButton");

    const categoryButtons =
      document.querySelectorAll(".category-button");

    const faqList =
      document.getElementById("faqList");

    const resultCount =
      document.getElementById("resultCount");

    let selectedCategory = "전체";


    function escapeHtml(text) {

      return String(text)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }


    function escapeRegExp(text) {

      return text.replace(
        /[.*+?^${}()|[\]\\]/g,
        "\\$&"
      );
    }


    function highlight(text, keyword) {

      const safeText =
        escapeHtml(text);

      if (!keyword.trim()) {
        return safeText;
      }

      const regex =
        new RegExp(
          `(${escapeRegExp(keyword.trim())})`,
          "gi"
        );

      return safeText.replace(
        regex,
        "<mark>$1</mark>"
      );
    }


    function getFilteredFaqs() {

      const keyword =
        searchInput.value
          .trim()
          .toLowerCase();

      return faqData.filter(item => {

        const categoryMatch =
          selectedCategory === "전체" ||
          item.category === selectedCategory;

        const text =
          `${item.question} ${item.answer_seed}`
            .toLowerCase();

        const keywordMatch =
          keyword === "" ||
          text.includes(keyword);

        return categoryMatch &&
               keywordMatch;
      });
    }


    function renderFaqs() {

      const keyword =
        searchInput.value.trim();

      const results =
        getFilteredFaqs();

      resultCount.innerHTML =
        `총 <strong>${results.length}</strong>건`;

      if (results.length === 0) {

        faqList.innerHTML = `
          <div class="empty-state">
            검색 결과가 없습니다.
          </div>
        `;

        return;
      }


      faqList.innerHTML =
        results.map(item => `

          <article class="faq-card">

            <span class="question-label">
              질문
            </span>

            <h3 class="faq-question">
              ${highlight(
                item.question,
                keyword
              )}
            </h3>

            <span class="answer-label">
              답변
            </span>

            <p class="faq-answer">
              ${highlight(
                item.answer_seed,
                keyword
              )}
            </p>

            <span class="category-badge">
              ${escapeHtml(item.category)}
            </span>

          </article>

        `).join("");
    }


    searchInput.addEventListener(
      "input",
      renderFaqs
    );


    categoryButtons.forEach(button => {

      button.addEventListener(
        "click",
        () => {

          selectedCategory =
            button.dataset.category;

          categoryButtons.forEach(
            btn =>
              btn.classList.remove("active")
          );

          button.classList.add("active");

          renderFaqs();
        }
      );
    });


    resetButton.addEventListener(
      "click",
      () => {

        searchInput.value = "";

        selectedCategory = "전체";

        categoryButtons.forEach(btn => {

          btn.classList.toggle(
            "active",
            btn.dataset.category === "전체"
          );

        });

        renderFaqs();

        searchInput.focus();
      }
    );


    renderFaqs();

  </script>

</body>
</html>
